#!/usr/bin/python3
"""Narrow root helper for Luminara's local Wi-Fi and Bluetooth settings screen."""

from __future__ import annotations

import json
from pathlib import Path
import re
import subprocess
import sys
import time


def run(*args: str, input_text: str = "", timeout: int = 15) -> str:
    try:
        result = subprocess.run(args, input=input_text, text=True, capture_output=True,
                                timeout=timeout, check=False)
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"{args[0]} unavailable or timed out") from exc
    output = (result.stdout or "") + (result.stderr or "")
    if result.returncode:
        raise RuntimeError(output.strip() or f"{args[0]} failed")
    return output.strip()


def split_nmcli(line: str) -> list[str]:
    fields, value, escaped = [], [], False
    for char in line:
        if escaped:
            value.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            fields.append("".join(value))
            value = []
        else:
            value.append(char)
    if escaped:
        value.append("\\")
    fields.append("".join(value))
    return fields


def wifi_status() -> dict:
    enabled = run("nmcli", "-t", "radio", "wifi").lower() == "enabled"
    output = run("nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device")
    for line in output.splitlines():
        fields = split_nmcli(line)
        if len(fields) >= 4 and fields[1] == "wifi" and fields[2] == "connected":
            return {"available": True, "enabled": enabled, "connected": fields[3]}
    return {"available": True, "enabled": enabled, "connected": ""}


def bluetooth_status() -> dict:
    output = run("bluetoothctl", "show", timeout=8)
    powered = re.search(r"^\s*Powered:\s*(yes|no)\s*$", output, re.MULTILINE | re.IGNORECASE)
    if not powered:
        raise RuntimeError("Bluetooth controller status is unavailable")
    return {"available": True, "enabled": powered.group(1).lower() == "yes"}


def unblock_bluetooth() -> None:
    """Clear Linux's soft rfkill block before asking BlueZ to power the adapter."""
    for radio in Path("/sys/class/rfkill").glob("rfkill*"):
        try:
            if (radio / "type").read_text().strip() == "bluetooth":
                (radio / "state").write_text("1\n")
        except OSError as exc:
            raise RuntimeError(f"Could not unblock Bluetooth radio: {exc}") from exc


def wifi_profiles() -> list[dict]:
    output = run("nmcli", "-t", "-f", "NAME,TYPE", "connection", "show")
    profiles = []
    for line in output.splitlines():
        fields = split_nmcli(line)
        if len(fields) < 2 or fields[1] != "802-11-wireless":
            continue
        name = fields[0]
        ssid = run("nmcli", "-g", "802-11-wireless.ssid", "connection", "show", "id", name).strip()
        if ssid:
            profiles.append({"name": name, "ssid": ssid})
    return profiles


def prefer_wifi(ssid: str) -> None:
    profile = next((p for p in wifi_profiles() if p["ssid"] == ssid), None)
    if profile:
        run("nmcli", "connection", "modify", "id", profile["name"],
            "connection.autoconnect", "yes", "connection.autoconnect-priority", "100")


def wifi_scan() -> list[dict]:
    output = run("nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list", "--rescan", "yes", timeout=18)
    networks, seen = [], set()
    for line in output.splitlines():
        fields = split_nmcli(line)
        if len(fields) < 4:
            continue
        active, ssid, signal, security = fields[:4]
        if not ssid or ssid in seen:
            continue
        seen.add(ssid)
        networks.append({"ssid": ssid, "signal": int(signal) if signal.isdigit() else 0,
                         "security": "" if security in ("", "--") else security, "active": active == "*"})
    saved = {p["ssid"] for p in wifi_profiles()}
    for network in networks:
        network["saved"] = network["ssid"] in saved
    return sorted(networks, key=lambda n: (not n["active"], -n["signal"], n["ssid"].casefold()))


def wifi_saved() -> list[dict]:
    active = wifi_status().get("connected", "")
    return [{"ssid": p["ssid"], "saved": True, "active": p["name"] == active, "signal": 0, "security": "Saved"}
            for p in wifi_profiles()]


def wifi_forget(ssid: str) -> str:
    if not isinstance(ssid, str) or not ssid or ssid.startswith("-") or len(ssid.encode()) > 32 or "\0" in ssid:
        raise ValueError("Choose a valid Wi-Fi network")
    profiles = [p["name"] for p in wifi_profiles() if p["ssid"] == ssid]
    if not profiles:
        raise RuntimeError("No saved Wi-Fi profile was found for that network")
    for name in profiles:
        run("nmcli", "connection", "delete", "id", name)
    return f"Forgot {ssid}"


def bluetooth_devices(scan: bool = False) -> list[dict]:
    if scan:
        proc = subprocess.Popen(("bluetoothctl", "--agent", "NoInputNoOutput", "--timeout", "12"),
                                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True)
        assert proc.stdin
        proc.stdin.write("power on\nscan on\n")
        proc.stdin.flush()
        time.sleep(8)
        proc.stdin.write("scan off\ndevices\nquit\n")
        proc.stdin.flush()
        try:
            output, _ = proc.communicate(timeout=6)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.communicate()
            raise RuntimeError("Bluetooth scan timed out")
    else:
        output = run("bluetoothctl", "devices", timeout=8)
    paired_output = run("bluetoothctl", "devices", "Paired", timeout=8)
    paired = {match.group(1).upper() for match in re.finditer(r"Device ([0-9A-Fa-f:]{17})", paired_output)}
    connected_output = run("bluetoothctl", "devices", "Connected", timeout=8)
    connected = {match.group(1).upper() for match in re.finditer(r"Device ([0-9A-Fa-f:]{17})", connected_output)}
    devices = {}
    for line in output.splitlines():
        match = re.search(r"Device ([0-9A-Fa-f:]{17})\s+(.+)$", line)
        if match:
            address, name = match.groups()
            address = address.upper()
            devices[address] = {"address": address, "name": name.strip(), "paired": address in paired,
                                "connected": address in connected}
    return sorted(devices.values(), key=lambda d: (not d["paired"], d["name"].casefold()))


def bluetooth_pair(address: str) -> str:
    """Pair through one interactive bluetoothctl agent, then confirm BlueZ kept the bond."""
    address = address.upper()
    proc = subprocess.Popen(("bluetoothctl", "--agent", "NoInputNoOutput"), stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    assert proc.stdin
    try:
        # bluetoothctl registers its agent at startup. Give it a moment before sending
        # commands; registering a second agent from stdin makes pairing fail on BlueZ.
        time.sleep(0.7)
        proc.stdin.write(f"pair {address}\n")
        proc.stdin.flush()
        time.sleep(18)
        proc.stdin.write(f"trust {address}\nquit\n")
        proc.stdin.flush()
        output, _ = proc.communicate(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()
        output, _ = proc.communicate()
        raise RuntimeError("Bluetooth pairing timed out")
    paired = run("bluetoothctl", "devices", "Paired", timeout=8)
    if not re.search(rf"Device {re.escape(address)}(?:\s|$)", paired, re.IGNORECASE):
        detail = " · ".join(line.strip() for line in output.splitlines() if line.strip())
        raise RuntimeError(detail[-500:] or "Bluetooth did not keep the pairing. Keep the device in pairing mode and try again.")
    return "Paired and trusted"


def main() -> None:
    try:
        request = json.load(sys.stdin)
        action = request.get("action")
        if action == "wifi-status":
            result = wifi_status()
        elif action == "wifi-radio":
            enabled = request.get("enabled")
            if not isinstance(enabled, bool):
                raise ValueError("Choose whether Wi-Fi should be on or off")
            run("nmcli", "radio", "wifi", "on" if enabled else "off", timeout=12)
            result = {"message": f"Wi-Fi turned {'on' if enabled else 'off'}", **wifi_status()}
        elif action == "wifi-scan":
            result = {"networks": wifi_scan()}
        elif action == "wifi-connect":
            ssid, password = request.get("ssid"), request.get("password", "")
            if (not isinstance(ssid, str) or not ssid or ssid.startswith("-") or len(ssid.encode()) > 32
                    or "\0" in ssid or not isinstance(password, str) or len(password) > 63 or "\0" in password):
                raise ValueError("Choose a valid Wi-Fi network and password")
            args = ("nmcli", "--ask", "--wait", "30", "device", "wifi", "connect", ssid) if password else (
                "nmcli", "--wait", "30", "device", "wifi", "connect", ssid)
            result = {"message": run(*args, input_text=password + "\n", timeout=35)}
            prefer_wifi(ssid)
        elif action == "wifi-connect-saved":
            ssid = request.get("ssid")
            if not isinstance(ssid, str) or not ssid or ssid.startswith("-") or len(ssid.encode()) > 32 or "\0" in ssid:
                raise ValueError("Choose a valid Wi-Fi network")
            profile = next((p for p in wifi_profiles() if p["ssid"] == ssid), None)
            if not profile:
                raise RuntimeError("No saved Wi-Fi profile was found for that network")
            result = {"message": run("nmcli", "connection", "up", "id", profile["name"], timeout=30)}
            prefer_wifi(ssid)
        elif action == "wifi-saved":
            result = {"networks": wifi_saved()}
        elif action == "wifi-disconnect":
            output = run("nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device")
            devices = [fields[0] for line in output.splitlines() for fields in [split_nmcli(line)]
                       if len(fields) >= 3 and fields[1] == "wifi" and fields[2] == "connected"]
            if not devices:
                raise RuntimeError("Wi-Fi is already disconnected")
            result = {"message": run("nmcli", "device", "disconnect", devices[0], timeout=12)}
        elif action == "wifi-forget":
            result = {"message": wifi_forget(request.get("ssid"))}
        elif action == "bluetooth-devices":
            result = {"devices": bluetooth_devices()}
        elif action == "bluetooth-status":
            result = bluetooth_status()
        elif action == "bluetooth-radio":
            enabled = request.get("enabled")
            if not isinstance(enabled, bool):
                raise ValueError("Choose whether Bluetooth should be on or off")
            if enabled:
                unblock_bluetooth()
                try:
                    message = run("bluetoothctl", "power", "on", timeout=12)
                except RuntimeError:
                    # Recover controllers that BlueZ leaves in off-blocked after a radio cycle.
                    run("systemctl", "restart", "bluetooth", timeout=18)
                    message = run("bluetoothctl", "power", "on", timeout=12)
            else:
                message = run("bluetoothctl", "power", "off", timeout=12)
            result = {"message": message, **bluetooth_status()}
        elif action == "bluetooth-scan":
            result = {"devices": bluetooth_devices(scan=True)}
        elif action == "bluetooth-pair":
            address = request.get("address")
            if not isinstance(address, str) or not re.fullmatch(r"(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}", address):
                raise ValueError("Choose a Bluetooth device from the scan list")
            result = {"message": bluetooth_pair(address)}
        elif action == "bluetooth-connect":
            address = request.get("address")
            if not isinstance(address, str) or not re.fullmatch(r"(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}", address):
                raise ValueError("Choose a Bluetooth device from the scan list")
            result = {"message": run("bluetoothctl", "connect", address.upper(), timeout=20)}
        elif action == "bluetooth-disconnect":
            address = request.get("address")
            if not isinstance(address, str) or not re.fullmatch(r"(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}", address):
                raise ValueError("Choose a Bluetooth device from the list")
            result = {"message": run("bluetoothctl", "disconnect", address.upper(), timeout=12)}
        elif action == "bluetooth-forget":
            address = request.get("address")
            if not isinstance(address, str) or not re.fullmatch(r"(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}", address):
                raise ValueError("Choose a Bluetooth device from the list")
            result = {"message": run("bluetoothctl", "remove", address.upper(), timeout=12)}
        else:
            raise ValueError("Unknown network action")
        print(json.dumps({"ok": True, **result}))
    except (ValueError, RuntimeError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}))
        raise SystemExit(1)


if __name__ == "__main__":
    main()
